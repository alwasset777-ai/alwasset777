{
  "name": "desktop",
  "productName": "Al Wasset 777",
  "private": true,
  "version": "0.1.0",
  "description": "Al Wasset 777 — gestion immobilière",
  "author": "Al Wasset 777 <alwasset777@gmail.com>",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build-electron.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && node scripts/build-electron.mjs --prod",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "build:dir": "npm run build && electron-builder --dir --config electron-builder.yml",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@alwasset/shared": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.0",
    "wait-on": "^9.4.0"
  }
}
